backup_date=$(date +%Y%m%d)

ALERT_LOG="$ALERT_DIR/alert_${ORACLE_SID}.log"
ARCHIVE_LOG="$ALERT_DIR/alert_${ORACLE_SID}_${backup_date}.log"

if [ -f "$ALERT_LOG" ]; then
  
    cp -a "$ALERT_LOG" "$ARCHIVE_LOG"
    cat /dev/null > "$ALERT_LOG"
else
    exit 1
fi

find "$ALERT_DIR" -name "alert_${ORACLE_SID}_*.log" -mtime +2 -exec rm -f {} \;

