#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: $0 <ORACLE_SID>"
    echo "Example: $0 ORCL"
    exit 1
fi

source ~/.bash_profile

export ORACLE_SID=$1
ORACLE_SID_LOWER=${ORACLE_SID,,}
ADR_HOME="diag/rdbms/${ORACLE_SID,,}/${ORACLE_SID}"

if [ -z "$ORACLE_HOME" ]; then
    ORACLE_HOME="/u01/app/oracle/product/19.3.0/dbhome_1"
fi

# 2일 이상된 파일들 삭제
$ORACLE_HOME/bin/adrci exec="set homepath ${ADR_HOME}; purge -age 2880 -type TRACE"


